{
  "name": "drift-agent-monitor",
  "displayName": "Drift",
  "description": "Monitors Claude Code sessions locally and flags low-value compute -- repeated retries, stale rereads, redundant subagent work -- using a fully local model. No cloud calls, no session data leaves your machine.",
  "version": "0.1.2",
  "publisher": "KathaNaik",
  "icon": "resources/drift-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KathaNaik/drift.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "claude code",
    "claude",
    "ai agent",
    "coding agent",
    "observability",
    "local model",
    "sustainability",
    "llama.cpp"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "drift",
          "title": "Drift",
          "icon": "resources/drift-icon.svg"
        }
      ]
    },
    "views": {
      "drift": [
        {
          "id": "drift.sidebar",
          "name": "Drift"
        },
        {
          "id": "drift.findings",
          "name": "Findings"
        },
        {
          "id": "drift.inspector",
          "name": "Trajectory Inspector"
        },
        {
          "id": "drift.report",
          "name": "Session Report"
        }
      ]
    },
    "commands": [
      {
        "command": "drift.installClaudeHooks",
        "title": "Drift: Configure Claude Code Hooks"
      },
      {
        "command": "drift.analyzeSession",
        "title": "Drift: Analyze Session",
        "icon": "$(search)"
      },
      {
        "command": "drift.setupLocalModel",
        "title": "Drift: Setup Local Model"
      },
      {
        "command": "drift.inspectSession",
        "title": "Drift: Inspect Session",
        "icon": "$(list-tree)"
      },
      {
        "command": "drift.viewSessionReport",
        "title": "Drift: View Session Report",
        "icon": "$(graph)"
      },
      {
        "command": "drift.prepareRedirect",
        "title": "Drift: Prepare Redirect"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "drift.analyzeSession",
          "when": "view == drift.findings",
          "group": "navigation"
        },
        {
          "command": "drift.inspectSession",
          "when": "view == drift.inspector",
          "group": "navigation"
        },
        {
          "command": "drift.viewSessionReport",
          "when": "view == drift.report",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "drift.prepareRedirect",
          "when": "view == drift.findings && viewItem == drift.finding.redirect_candidate"
        }
      ]
    },
    "configuration": {
      "title": "Drift",
      "properties": {
        "drift.otlp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Export captured Claude Code session traces to an OTLP collector. Disabled by default."
        },
        "drift.otlp.endpoint": {
          "type": "string",
          "default": "",
          "description": "OTLP/HTTP JSON traces endpoint to export to, e.g. http://localhost:4318/v1/traces. Only used when drift.otlp.enabled is true."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --target darwin-arm64"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "glob": "^10.3.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
