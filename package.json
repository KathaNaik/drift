{
  "name": "drift",
  "displayName": "Drift",
  "description": "Monitors coding-agent trajectories and detects low-value compute.",
  "version": "0.0.1",
  "private": true,
  "publisher": "drift",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "drift",
          "title": "Drift",
          "icon": "resources/drift-icon.svg"
        }
      ]
    },
    "views": {
      "drift": [
        {
          "id": "drift.sidebar",
          "name": "Drift"
        },
        {
          "id": "drift.findings",
          "name": "Findings"
        }
      ]
    },
    "commands": [
      {
        "command": "drift.installClaudeHooks",
        "title": "Drift: Configure Claude Code Hooks"
      },
      {
        "command": "drift.analyzeSession",
        "title": "Drift: Analyze Session",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "drift.analyzeSession",
          "when": "view == drift.findings",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Drift",
      "properties": {
        "drift.otlp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Export captured Claude Code session traces to an OTLP collector. Disabled by default."
        },
        "drift.otlp.endpoint": {
          "type": "string",
          "default": "",
          "description": "OTLP/HTTP JSON traces endpoint to export to, e.g. http://localhost:4318/v1/traces. Only used when drift.otlp.enabled is true."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^10.3.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
